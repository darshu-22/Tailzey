# Copy to backend/.env and adjust. Placeholders only — never commit real secrets.
APP_ENV=development
# SQLite for local dev; e.g. postgresql+psycopg://user:pass@host/tailzey in production
DATABASE_URL=sqlite:///./tailzey.db
# Exact frontend origins, comma-separated (no wildcards)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_HOURS=336
# Forced on when APP_ENV=production
SESSION_COOKIE_SECURE=false
AUTH_RATE_LIMIT_PER_MINUTE=10
ANALYZE_RATE_LIMIT_PER_MINUTE=6
# heavy = most accurate (~50 ms/photo), full / lite = faster
CV_POSE_MODEL=heavy
CV_MAX_WORKERS=2
CV_MAX_IMAGE_BYTES=8388608
CV_MAX_IMAGE_SIDE=1280
